{
  "mcpServers": {
    "icloud-calendar": {
      "command": "npx",
      "args": ["--yes", "@lukegskw/caldav-mcp@latest"],
      "env_vars": [
        "CALDAV_PROVIDER",
        "CALDAV_URL",
        "CALDAV_USERNAME",
        "CALDAV_PASSWORD",
        "CALDAV_MCP_LOG_LEVEL",
        "CALDAV_MCP_REQUEST_TIMEOUT_MS"
      ]
    }
  }
}
