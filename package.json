{
  "name": "@lukegskw/caldav-mcp",
  "version": "0.1.6",
  "license": "MIT",
  "bin": {
    "caldav-mcp": "dist/main.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "server.json"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/lukegskw/caldav-mcp.git"
  },
  "homepage": "https://github.com/lukegskw/caldav-mcp#readme",
  "bugs": {
    "url": "https://github.com/lukegskw/caldav-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "caldav",
    "icloud",
    "icloud-calendar",
    "calendar",
    "icalendar",
    "valarm",
    "claude",
    "codex",
    "gemini"
  ],
  "publishConfig": {
    "access": "public"
  },
  "mcpName": "io.github.lukegskw/caldav-mcp",
  "description": "A TypeScript MCP server for iCloud Calendar with native multi-VALARM support.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "release:prepare": "node scripts/prepare-release.mjs",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration",
    "test:distribution": "node scripts/check-distribution.mjs",
    "test:package": "node scripts/check-package.mjs",
    "test:unit": "vitest run tests/unit",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/express": "^2.0.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "express": "^5.2.1",
    "ical.js": "^2.2.1",
    "tsdav": "^2.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "eslint": "^10.8.0",
    "eslint-plugin-import-x": "^4.17.1",
    "globals": "^17.7.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
